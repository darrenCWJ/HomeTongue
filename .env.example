# ── Server-side secrets (never exposed to the browser) ──────────────
# Used by the Vercel functions in api/ and the Vite dev middleware.

# OpenAI — translation, suggestions, persona generation, speech-to-text
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Google Cloud service account JSON (single-line string) — Chirp 3 HD TTS
# Needs the Cloud Text-to-Speech API enabled on the project.
GOOGLE_API_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ── Client-side config (VITE_ vars are embedded in the JS bundle — ──
# ── never put real secrets here) ─────────────────────────────────────

# Access code gate — a soft gate only; the value ships in the bundle.
# Leave unset to disable the gate (open access).
VITE_ACCESS_CODE=your-access-code-here

# Storage mode: "local" (IndexedDB) or "cloud" (Supabase, not yet implemented)
VITE_STORAGE_MODE=local

# Base URL for the app's own /api endpoints.
# Leave unset for web builds (same origin). REQUIRED for Capacitor native
# builds — set to the deployed web origin, e.g. https://hometongue.vercel.app
# VITE_API_BASE_URL=
