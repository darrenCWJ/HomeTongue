# ── Server-side secrets (never exposed to the browser) ──────────────
# Used by the Vercel functions in api/ and the Vite dev middleware.

# OpenAI — translation, suggestions, persona generation, speech-to-text
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Google Cloud service account JSON (single-line string) — Chirp 3 HD TTS
# Needs the Cloud Text-to-Speech API enabled on the project.
GOOGLE_API_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ── Client-side config (VITE_ vars are embedded in the JS bundle — ──
# ── never put real secrets here) ─────────────────────────────────────

# Access code gate — a soft gate only; the value ships in the bundle.
# Leave unset to disable the gate (open access).
VITE_ACCESS_CODE=your-access-code-here

# Storage mode: "local" (IndexedDB, default) or "cloud" (Supabase).
# Cloud mode also requires the VITE_SUPABASE_* vars below; if they are absent
# the app falls back to local storage with a console warning.
VITE_STORAGE_MODE=local

# ── Supabase (optional — cloud storage mode) ─────────────────────────
# Create a project at https://supabase.com, apply
# supabase/migrations/0001_initial_schema.sql (SQL editor or `supabase db push`),
# then set all three values. The anon key is PUBLIC BY DESIGN — it ships in
# the JS bundle; Row-Level Security (RLS) on every table is the actual
# security boundary. Never put the service-role key in a VITE_ variable.
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...
# VITE_STORAGE_MODE=cloud

# Base URL for the app's own /api endpoints.
# Leave unset for web builds (same origin). REQUIRED for Capacitor native
# builds — set to the deployed web origin, e.g. https://hometongue.vercel.app
# VITE_API_BASE_URL=

# ── Custom model serving (docs/ML_TRAINING_PLAN.md; both optional) ──
# OpenAI-compatible chat endpoint for a fine-tuned conversation model
# LLM_BASE_URL=
# LLM_API_KEY=
# Custom STT endpoint (JSON {audio,language,prompt} -> {text}), e.g. fine-tuned Whisper on Modal
# STT_BASE_URL=
# STT_API_KEY=
