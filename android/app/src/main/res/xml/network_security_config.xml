<?xml version="1.0" encoding="utf-8"?>
<!-- Defense-in-depth: block all cleartext HTTP traffic from the webview and
     native layers. All app traffic is HTTPS (Vercel origin + none else). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
