# HomeTongue Admin — environment variables
#
# Copy this file to .env (gitignored) and fill in the values. Use the SAME
# Supabase project as the main app (the root .env has identical values).
#
# The anon key is public by design — it ships in any client bundle. The real
# security boundary is server-side: Postgres RLS plus the public.is_admin()
# check (profiles.is_admin), applied by migration 0005_admin_review.sql.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
